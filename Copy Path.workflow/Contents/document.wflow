<dict>
	<key>AMApplicationBuild</key>
	<string>307</string>
	<key>AMApplicationVersion</key>
	<string>2.2</string>
	<key>actions</key>
	<array>
		<dict>
			<key>action</key>
			<dict>
				<key>AMAccepts</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Optional</key>
					<false/>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.path</string>
					</array>
				</dict>
				<key>AMActionVersion</key>
				<string>1.0</string>
				<key>AMProvides</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>AMRequiredResources</key>
				<array/>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash
# Copy absolute path(s) of selected Finder item(s).
first=1
emit() { if [ "$first" -eq 1 ]; then printf '%s' "$1"; first=0; else printf '\n%s' "$1"; fi; }
if [ "$#" -gt 0 ]; then
    for f in "$@"; do emit "$f"; done
else
    while IFS= read -r f; do [ -z "$f" ] &amp;&amp; continue; emit "$f"; done
fi | pbcopy
</string>
					<key>CheckedForUserDefaultShell</key>
					<false/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/bash</string>
					<key>source</key>
					<string></string>
				</dict>
				<key>BundleIdentifier</key>
				<string>com.apple.RunShellScript</string>
				<key>CanShowWhenRun</key>
				<false/>
				<key>Class Name</key>
				<string>Run_Shell_Script</string>
				<key>InputUUID</key>
				<string>a8f7c3bf-dc73-45d5-a5b9-c994c749e76d</string>
				<key>OutputUUID</key>
				<string>872af260-d924-4450-9691-a7f1c2200f86</string>
				<key>UUID</key>
				<string>9589d439-9dc2-4985-a433-f8ef5de12e66</string>
				<key>isViewVisible</key>
				<false/>
			</dict>
			<key>isViewVisible</key>
			<false/>
		</dict>
	</array>
	<key>workflowType</key>
	<integer>2</integer>
</dict>
</plist>
